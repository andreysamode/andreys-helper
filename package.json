{
  "name": "andreys-helper",
  "displayName": "Andrey's Helper",
  "description": "Worktree controls in the Source Control panel for VSCode and Cursor, driving the worktrunk (wt) CLI headlessly — create and remove git worktrees without touching the terminal.",
  "version": "0.4.133",
  "publisher": "andrey",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/andreysamode/andreys-helper.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "worktree",
    "worktrunk",
    "wt",
    "git",
    "cursor"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "wt.worktreeMenu",
        "title": "Worktree Actions",
        "category": "Worktrunk",
        "icon": {
          "light": "media/tree-dark.svg",
          "dark": "media/tree-light.svg"
        }
      },
      {
        "command": "wt.newWorktree",
        "title": "New Worktree",
        "category": "Worktrunk",
        "icon": "$(git-branch)"
      },
      {
        "command": "wt.removeWorktree",
        "title": "Remove Worktree",
        "category": "Worktrunk",
        "icon": "$(trash)"
      },
      {
        "command": "andreys-helper.claudePanes1",
        "title": "Ensure 1 Pane",
        "category": "Claude Panes"
      },
      {
        "command": "andreys-helper.claudePanes2",
        "title": "Ensure 2 Panes",
        "category": "Claude Panes"
      },
      {
        "command": "andreys-helper.claudePanes3",
        "title": "Ensure 3 Panes",
        "category": "Claude Panes"
      },
      {
        "command": "andreys-helper.inspectClaudeTabs",
        "title": "Inspect Tabs (debug)",
        "category": "Claude Panes"
      },
      {
        "command": "andreysHelper.kym.openBoard",
        "title": "Keep Your Marbles",
        "category": "Andrey's Helper",
        "icon": "media/columns.svg"
      },
      {
        "command": "andreysHelper.scm.viewAsList",
        "title": "View as List",
        "category": "Andrey's Helper",
        "icon": "media/view-list.svg"
      },
      {
        "command": "andreysHelper.scm.viewAsTree",
        "title": "View as Tree",
        "category": "Andrey's Helper",
        "icon": "media/view-tree.svg"
      },
      {
        "command": "andreysHelper.scm.refresh",
        "title": "Refresh",
        "category": "Andrey's Helper",
        "icon": "$(sync)"
      },
      {
        "command": "andreysHelper.scm.openSettings",
        "title": "Extension Settings",
        "category": "Andrey's Helper",
        "icon": "$(gear)"
      },
      {
        "command": "andreysHelper.claudePatchStatus",
        "title": "Show Claude Patch Status",
        "category": "Andrey's Helper"
      },
      {
        "command": "andreysHelper.updateClaudeCode",
        "title": "Update & Patch Claude Code",
        "category": "Andrey's Helper"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "andreysHelper",
          "title": "Andrey's Helper",
          "icon": "media/tree-dark.svg"
        }
      ]
    },
    "views": {
      "andreysHelper": [
        {
          "id": "andreysHelper.scm",
          "name": "Source+",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "andreysHelper.kym.openBoard",
          "when": "view == andreysHelper.scm",
          "group": "navigation@0"
        },
        {
          "command": "andreysHelper.scm.viewAsList",
          "when": "view == andreysHelper.scm && andreysHelper.scmViewMode == 'tree'",
          "group": "navigation@1"
        },
        {
          "command": "andreysHelper.scm.viewAsTree",
          "when": "view == andreysHelper.scm && andreysHelper.scmViewMode != 'tree'",
          "group": "navigation@1"
        },
        {
          "command": "andreysHelper.scm.refresh",
          "when": "view == andreysHelper.scm",
          "group": "navigation@2"
        },
        {
          "command": "andreysHelper.scm.openSettings",
          "when": "view == andreysHelper.scm",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "Andrey's Helper",
      "properties": {
        "andreysHelper.closeCursorAgent": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "When arranging Claude panes (C1/C2/C3), close Cursor's built-in agent first so it doesn't compete for editor space. Closes both shapes it takes — a webview editor matching `#andreysHelper.cursorAgentViewTypePattern#` and its blank-input editor tab. Claude tabs are webviews and never affected."
        },
        "andreysHelper.cursorAgentViewTypePattern": {
          "type": "string",
          "default": "aichat|composer|cursor.*(chat|agent|pane)|(chat|agent).*pane",
          "markdownDescription": "Case-insensitive regular expression matched against editor webview `viewType`s to identify Cursor's agent/chat tab for closing. Claude's own tabs are always excluded. Use the **Claude Panes: Inspect Tabs (debug)** command to discover the real viewType. Requires `#andreysHelper.closeCursorAgent#`."
        },
        "andreysHelper.kym.snippets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "tag": {
                "type": "string"
              },
              "body": {
                "type": "string"
              }
            }
          },
          "default": [],
          "markdownDescription": "Global **Keep Your Marbles** prompt snippets. Each has a short `tag` and a `body`; dragging the tag into a task's prompt expands it to the body. These are the global defaults — per-repo snippets in `.vscode/kym.json` are merged on top."
        },
        "andreysHelper.kym.stageInstructions": {
          "type": "object",
          "properties": {
            "plan": {
              "type": "string"
            },
            "process": {
              "type": "string"
            },
            "verify": {
              "type": "string"
            },
            "done": {
              "type": "string"
            },
            "archive": {
              "type": "string"
            }
          },
          "default": {},
          "markdownDescription": "Global extra instructions appended to the prompt when a **Keep Your Marbles** marble enters each stage (e.g. a Process instruction to *output a list of items for the user to verify*). Per-repo overrides live in `.vscode/kym.json`."
        },
        "andreysHelper.startupPanes": {
          "type": "integer",
          "enum": [
            0,
            1,
            2,
            3
          ],
          "default": 0,
          "markdownDescription": "Automatically arrange Claude panes to this many columns when a window finishes starting up, replacing the restored layout. `0` disables it (default). The editor restores its previous layout first and this then re-arranges into the chosen column count — opening fresh Claude sessions if the window restored with none. Equivalent to pressing **C1/C2/C3** on startup."
        },
        "andreysHelper.claudeCodePatch": {
          "type": "null",
          "default": null,
          "markdownDescription": "➜ **[Open the Claude Code Patch panel](command:andreysHelper.claudePatchStatus)**"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "compile": "tsc --noEmit",
    "test": "esbuild src/*.test.ts --bundle --platform=node --format=cjs --outdir=dist-test --out-extension:.js=.cjs --log-level=warning && node --test dist-test/*.test.cjs",
    "build:cli": "esbuild cli/ah.ts --bundle --platform=node --format=cjs --outfile=dist/ah.js --log-level=warning && chmod +x dist/ah.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.18.1",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.20.0",
    "minimatch": "^10.2.5",
    "typescript": "^5.4.0"
  },
  "allowScripts": {
    "esbuild@0.20.2": true
  },
  "dependencies": {
    "adm-zip": "^0.5.18",
    "ws": "^8.21.1"
  }
}
